# ============================================================
# Шаблон конфигурации. Скопируй в .env и заполни реальными значениями.
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# Файл .env в git не попадает — он в .gitignore.
# ============================================================

# --- Telegram -----------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=
# ID группы менеджеров, куда приходят уведомления о заказах.
# У групп/супергрупп id отрицательный, например -1001234567890
GROUP_ID=

# --- ЮКасса -------------------------------------------------
# Личный кабинет: yookassa.ru → Настройки → API
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# --- Webhook ------------------------------------------------
# Публичный адрес сервера, на который ЮКасса шлёт уведомления об оплате
WEBHOOK_HOST=https://example.com
WEBHOOK_PATH=/webhook/yukassa
WEBHOOK_PORT=8080

# --- 1С УНФ (COM) -------------------------------------------
# false — бот выдаёт тестовые коды TEST-CODE-..., 1С не требуется
# true  — боевой режим, коды берутся из 1С (только на сервере с базой)
ONEC_ENABLED=false

# Путь к каталогу файловой базы 1С на сервере
ONEC_BASE_PATH=C:\path\to\1c\base
# Пользователь и пароль ВНУТРИ 1С (не учётная запись Windows)
ONEC_USERNAME=
ONEC_PASSWORD=
